{
  "hosting": {
    "public": ".",
    "ignore": [
      ".github/**",
      "CLAUDE.md",
      "README.md",
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/fundraiser",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/fundraiser/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/resources",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/resources/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/client-checkin",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/client-checkin/**",
        "destination": "/",
        "type": 301
      }
    ]
  }
}
